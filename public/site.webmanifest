{
  "name": "EZ Wonders",
  "short_name": "EZ Wonders",
  "description": "Free interactive numeracy games for Kindergarten children.",
  "categories": ["education", "kids", "games"],
  "lang": "en",
  "dir": "ltr",
  "id": "/",
  "icons": [
    { "src": "/favicon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "/favicon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/android-chrome-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#3fb6ea",
  "background_color": "#3fb6ea",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "start_url": "/",
  "scope": "/",
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "description": "Open EZ Wonders",
      "url": "/",
      "icons": [{ "src": "/favicon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Teacher guide",
      "short_name": "Teacher guide",
      "description": "How to set up your class in EZ Wonders",
      "url": "/teacher-onboarding",
      "icons": [{ "src": "/favicon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
